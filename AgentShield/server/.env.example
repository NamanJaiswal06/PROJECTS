# Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/agentshield
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/agentshield
MONGODB_URI=mongodb://localhost:27017/agentshield

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Use a long, random secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://agentshield.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stricter limits for sensitive endpoints (login, evaluate)
AUTH_RATE_LIMIT_MAX=10
ACTION_RATE_LIMIT_MAX=50

# ─── ML Service ────────────────────────────────────────────────────────────────
# Mode: MOCK (local fake) or HTTP (real ML service)
ML_SERVICE_MODE=MOCK
ML_SERVICE_URL=http://localhost:8000

# ─── Risk Engine Thresholds ───────────────────────────────────────────────────
# Score (0–100) above which action requires human approval
RISK_APPROVAL_THRESHOLD=60
# Score above which action is automatically blocked
RISK_BLOCK_THRESHOLD=80

# ─── Approval Expiry ──────────────────────────────────────────────────────────
# How long (hours) before a pending approval expires
APPROVAL_EXPIRY_HOURS=24

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
