QDRANT_URL=https://6fe28cd1-f8a0-4392-941f-b557d789d4cf.sa-east-1-0.aws.cloud.qdrant.io:6333
# ⚠️  If using Qdrant Cloud, replace above with your cluster URL from cloud.qdrant.io → Cluster → Endpoint
# Example: https://xxxx-xxxx-xxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6YzM3ZmNjYWItMmI4NS00Mzc1LWI4NTItMTk3ZmVmNDM4NjRmIn0.FokIP4Pffk7xKAoDeNTvQwkgV_XM0Wq7NDzXBkYvRoQ
