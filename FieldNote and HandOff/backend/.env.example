# ================================================
# FieldNote / HandOff — Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# ----- SERVER -----
PORT=5000
NODE_ENV=development

# ----- MONGODB -----
# Local:   mongodb://localhost:27017/fieldnote
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/fieldnote
MONGO_URI=mongodb://localhost:27017/fieldnote

# ----- JWT -----
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=24h

# ----- QDRANT -----
# Local Docker:  http://localhost:6333
# Qdrant Cloud:  https://<cluster-id>.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=             # Leave empty for local Docker; required for Qdrant Cloud
QDRANT_COLLECTION=unit_logs

# ----- GEMINI (Google AI) -----
# FREE — Get your key at https://aistudio.google.com → "Get API Key"
# Used for: embeddings (text-embedding-004, 768-dim) + LLM (gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# ----- RIME TTS -----
# Get your key at https://rime.ai
RIME_API_KEY=your_rime_api_key
RIME_VOICE=marsh           # Default voice — change to any Rime speaker ID
RIME_MODEL=mist            # mist | coda

# ----- DEEPGRAM STT -----
# Get your key at https://deepgram.com
# Used for streaming speech-to-text (nova-2 model)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ----- CORS -----
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
